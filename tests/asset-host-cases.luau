return function(h)
    h.test("avatar thumbnail user ids stay distinct from asset ids", function()
        local api, mock = h.make({ Config = { Assets = true } })
        local mesh = mock.instance("MeshPart", "Asset", mock.services.ReplicatedStorage)
        mesh.MeshId = "rbxassetid://123"
        local image = mock.instance("ImageLabel", "Avatar", mock.services.ReplicatedStorage)
        image.Image = "rbxthumb://type=AvatarHeadShot&id=123&w=150&h=150"
        h.equal(api.Dump.run(), true)
        h.equal(api.Dump.ctx.stats.assets, 2)
        h.equal(api.Dump.ctx.assets["id:123"].uses, 1)
        h.equal(api.Dump.ctx.assets["uri:" .. image.Image].id, nil)
    end)
    h.test("unrecognized id query urls are not normalized to assets", function()
        local api, mock = h.make({ Config = { Assets = true } })
        local image = mock.instance("ImageLabel", "URL", mock.services.ReplicatedStorage)
        image.Image = "https://example.com/avatar?id=777"
        h.equal(api.Dump.run(), true)
        h.equal(api.Dump.ctx.assetOrder[1].id, nil)
        h.equal(api.Dump.ctx.assetOrder[1].uri, image.Image)
    end)
    h.test("missing state without isfile still allows first capture", function()
        local api, mock = h.make({ globals = { isfile = false } })
        mock.instance("LocalScript", "First", mock.services.ReplicatedStorage)
        local ok, result = api.Dump.run()
        h.equal(ok, true)
        h.equal(api.Dump.ctx.stats.scripts, 1)
        h.equal(api.Dump.ctx.journalDisabled, true)
        h.equal(mock.files["Dumper/123/State.txt"], nil)
        h.contains(mock.files[result.manifest], "Persistent crash tracking disabled")
    end)
    h.test("unqueryable unreadable journal is left untouched", function()
        local journal = "FORMAT\t2\nSUSPECT\told-path\n"
        local api, mock = h.make({ globals = { isfile = false }, files = { ["Dumper/123/State.txt"] = journal } })
        mock.failRead = "Dumper/123/State.txt"
        mock.instance("LocalScript", "First", mock.services.ReplicatedStorage)
        h.equal(api.Dump.run(), true)
        h.equal(mock.files["Dumper/123/State.txt"], journal)
    end)
    h.test("successful saves release capture buffers and keep metadata", function()
        local api, mock = h.make()
        mock.instance("LocalScript", "Source", mock.services.ReplicatedStorage).source = "return 123\n"
        local ok, result = api.Dump.run()
        h.equal(ok, true)
        local ctx = api.Dump.ctx
        h.equal(ctx.buffersReleased, true)
        h.equal(#ctx.out.Scripts.parts, 0)
        h.equal(#ctx.queue, 0)
        h.equal(next(ctx.seenScripts), nil)
        h.equal(ctx.index[1].status, "ok")
        h.contains(mock.files[result.output], "return 123")
        h.equal(pcall(api.writeOutputs, ctx), false)
    end)
    h.test("failed saves retain capture buffers", function()
        local api, mock = h.make()
        mock.instance("LocalScript", "Recover", mock.services.ReplicatedStorage).source = "return 123\n"
        mock.failWrite = "Dumper/123/Dump.txt"
        h.equal(api.Dump.run(), false)
        h.equal(api.Dump.ctx.buffersReleased, nil)
        h.contains(api.Dump.ctx.out.Scripts:text(), "return 123")
    end)
    h.test("Potassium alias dumpstring resolves dynamically", function()
        local api, mock = h.make({ globals = { dumpstring = function() return "fixture bytecode" end } })
        h.equal(api.Has.bytecode, true)
        h.equal(api.Host.getscriptbytecode(), "fixture bytecode")
        h.equal(api.capabilityReport().aliases.getscriptbytecode, "dumpstring")
        mock.env.dumpstring = function() return "changed" end
        h.equal(api.Host.getscriptbytecode(), "changed")
    end)
    h.test("executor name and version are retained", function()
        local api = h.make({ globals = { getexecutorname = function() return "Potassium", "fixture-version" end } })
        local report = api.capabilityReport()
        h.equal(report.executor, "Potassium")
        h.equal(report.version, "fixture-version")
        h.equal(report.aliases.identifyexecutor, "getexecutorname")
    end)
    h.test("getgenv-only filesystem functions are usable", function()
        local api, mock = h.make()
        mock.sharedEnv.writefile = mock.env.writefile
        mock.sharedEnv.appendfile = mock.env.appendfile
        mock.env.writefile, mock.env.appendfile = false, false
        api.writeAll("env-only.txt", { "first", "second" })
        h.equal(mock.files["env-only.txt"], "firstsecond")
    end)
    h.test("executor version reaches report and manifest", function()
        local api, mock = h.make({ Config = { Info = true }, globals = {
            identifyexecutor = function() return "Potassium", "fixture-version" end,
        } })
        mock.services.Players.MaxPlayers = 100
        local ok, result = api.Dump.run()
        h.equal(ok, true)
        h.contains(mock.files[result.output], "Potassium  version fixture-version")
        h.contains(mock.files[result.manifest], "Potassium  version fixture-version")
    end)
    h.test("empty bytecode still attempts decompilation", function()
        local api, mock = h.make({ globals = { dumpstring = function() return "" end } })
        local instance = mock.instance("LocalScript", "Readable", mock.services.ReplicatedStorage)
        instance.source = "return 'available'\n"
        h.equal(api.Dump.run(), true)
        h.contains(mock.files[api.Dump.lastOutput], "return 'available'")
        h.equal(api.Dump.ctx.stats.scripts, 1)
    end)
    h.test("asset inventory merges equivalent ids and keeps locations", function()
        local api, mock = h.make({ Config = { Assets = true, AssetSamples = 1 } })
        local mesh = mock.instance("MeshPart", "Mesh", mock.services.ReplicatedStorage)
        mesh.MeshId, mesh.TextureID = "rbxassetid://123", "rbxassetid://456"
        local image = mock.instance("ImageLabel", "Image", mock.services.ReplicatedStorage)
        image.Image = "https://www.roblox.com/asset/?id=123"
        h.equal(api.Dump.run(), true)
        h.equal(api.Dump.ctx.stats.assets, 2)
        h.equal(api.Dump.ctx.stats.assetUses, 3)
        local entry = api.Dump.ctx.assets["id:123"]
        h.equal(entry.uses, 2)
        h.equal(#entry.references, 1)
        h.contains(mock.files[api.Dump.lastOutput], "ASSETS")
        h.contains(mock.files[api.Dump.lastOutput], "MeshPart.MeshId")
        h.contains(mock.files[api.Dump.lastOutput], "+1 uses")
    end)
    h.test("readable Content Uri preferred over deprecated texture", function()
        local api, mock = h.make({ Config = { Assets = true } })
        local decal = mock.instance("Decal", "Poster", mock.services.ReplicatedStorage)
        decal.ColorMapContent = { __kind = "Content", Uri = "rbxassetid://789" }
        decal.Texture = "rbxassetid://111"
        h.equal(api.Dump.run(), true)
        h.equal(api.Dump.ctx.stats.assets, 1)
        h.equal(api.Dump.ctx.assetOrder[1].id, "789")
        h.equal(api.Dump.ctx.assetOrder[1].references[1].property, "ColorMapContent")
    end)
    h.test("asset object content and zero ids are not fetched", function()
        local api, mock = h.make({ Config = { Assets = true } })
        local image = mock.instance("ImageButton", "Button", mock.services.ReplicatedStorage)
        image.Image, image.HoverImage = "rbxassetid://0", "rbxassetid://000"
        local decal = mock.instance("Decal", "ObjectContent", mock.services.ReplicatedStorage)
        decal.ColorMapContent = { __kind = "Content", Uri = nil }
        h.equal(api.Dump.run(), true)
        h.equal(api.Dump.ctx.stats.assets, 0)
    end)
    h.test("asset caps record omitted references without losing duplicates", function()
        local api, mock = h.make({ Config = { Assets = true, MaxAssets = 1 } })
        local image = mock.instance("ImageButton", "Button", mock.services.ReplicatedStorage)
        image.Image, image.HoverImage, image.PressedImage = "rbxassetid://1", "rbxassetid://2", "rbxassetid://1"
        h.equal(api.Dump.run(), true)
        h.equal(api.Dump.ctx.stats.assets, 1)
        h.equal(api.Dump.ctx.stats.assetUses, 2)
        h.equal(api.Dump.ctx.stats.assetOverflow, 1)
    end)
    h.test("assets inside folded folders are still inventoried", function()
        local api, mock = h.make({ Config = { Assets = true } })
        for _ = 1, 4 do
            local folder = mock.instance("Folder", "Clone", mock.services.ReplicatedStorage)
            local sound = mock.instance("Sound", "Unique", folder)
            sound.SoundId = "rbxassetid://42"
        end
        h.equal(api.Dump.run(), true)
        h.equal(api.Dump.ctx.assets["id:42"].uses, 4)
    end)
    h.test("normal dump exports collected source with manifest links", function()
        local api, mock = h.make({ Config = { ExportScripts = true, HideName = true } })
        local instance = mock.instance("LocalScript", "Source", mock.services.ReplicatedStorage)
        instance.source = "return 'FixturePlayer'"
        local ok, result = api.Dump.run()
        h.equal(ok, true)
        local row = api.Dump.ctx.index[1]
        h.equal(mock.files[row.exportFile], instance.source)
        h.contains(mock.files[result.manifest], row.exportFile)
        h.equal(row.exportSource, nil)
    end)
end
